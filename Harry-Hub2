local walkSpeed = 16
local flySpeed = 50
local flying = false
local noclipEnabled = false
local minimizedState = false
local closed = false

local flightConnection
local noclipConnection
local bodyVelocity
local oldAutoRotate
local oldPlatformStand
local oldCollisions = {}
local lastCharacter

local function getCharacterParts()
    local character = player.Character
    if not character then
        return nil, nil, nil
    end

    return character,
        character:FindFirstChildOfClass("Humanoid"),
        character:FindFirstChild("HumanoidRootPart")
end

local function parseSpeed(box, status, label)
    local n = tonumber(box.Text)

    if not n or n < 1 or n > 100000 or n % 1 ~= 0 then
        status.Text = "請輸入 1～100000 的整數"
        return nil
    end

    status.Text = label .. "：" .. n
    return n
end

walkApply.Activated:Connect(function()
    local n = parseSpeed(walkBox, walkStatus, "目前移動速度")
    if not n then return end

    walkSpeed = n

    local _, humanoid = getCharacterParts()
    if humanoid then
        humanoid.WalkSpeed = n
    end
end)

flyApply.Activated:Connect(function()
    local n = parseSpeed(flyBox, flyStatus, "目前飛行速度")
    if n then
        flySpeed = n
    end
end)

local function stopFlying()
    flying = false

    if flightConnection then
        flightConnection:Disconnect()
        flightConnection = nil
    end

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    local _, humanoid, root = getCharacterParts()

    if humanoid then
        humanoid.PlatformStand = oldPlatformStand or false
        humanoid.AutoRotate = oldAutoRotate ~= false
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    flyToggle.Text = "飛行：已關閉"
    flyToggle.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
end

local function startFlying()
    local _, humanoid, root = getCharacterParts()

    if not humanoid or not root then
        flyStatus.Text = "找不到角色，請重新嘗試"
        return
    end

    oldAutoRotate = humanoid.AutoRotate
    oldPlatformStand = humanoid.PlatformStand

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "HarryHubFlightVelocity"
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.P = 1e5
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = root

    flying = true
    flyToggle.Text = "飛行：已開啟"
    flyToggle.BackgroundColor3 = Color3.fromRGB(150, 25, 35)

    flightConnection = RunService.Heartbeat:Connect(function()
        if closed or not flying or not root.Parent or not bodyVelocity then
            stopFlying()
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then return end

        local cf = camera.CFrame
        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += cf.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= cf.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += cf.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= cf.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        -- BodyVelocity 持續抵銷重力，靜止時維持高度。
        bodyVelocity.Velocity = direction * flySpeed

        local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if look.Magnitude > 0.001 then
            root.CFrame = CFrame.lookAt(root.Position, root.Position + look.Unit)
        end

        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

flyToggle.Activated:Connect(function()
    if flying then
        stopFlying()
    else
        startFlying()
    end
end)

-- 單腳本穿牆模式：
-- 關閉角色自身碰撞，並以向下射線嘗試維持地面高度。
-- 這是地面高度修正，不等同於真正的地板物理碰撞。
local function restoreCharacterCollisions(character)
    local saved = oldCollisions[character]
    if saved then
        for part, original in pairs(saved) do
            if part and part.Parent then
                part.CanCollide = original
            end
        end
        oldCollisions[character] = nil
    end
end

local function setNoclip(enabled)
    noclipEnabled = enabled

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    if not enabled then
        for character in pairs(oldCollisions) do
            restoreCharacterCollisions(character)
        end

        noclipToggle.Text = "穿牆：已關閉"
        noclipToggle.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
        return
    end

    noclipToggle.Text = "穿牆：已開啟"
    noclipToggle.BackgroundColor3 = Color3.fromRGB(150, 25, 35)

    noclipConnection = RunService.Heartbeat:Connect(function()
        if closed or not noclipEnabled then return end

        local character, humanoid, root = getCharacterParts()
        if not character or not humanoid or not root then return end

        oldCollisions[character] = oldCollisions[character] or {}

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                local saved = oldCollisions[character]
                if saved[part] == nil then
                    saved[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end

        -- 地面高度修正：接近地面且正在下落或靜止時，將角色放回地面高度。
        -- 上升時不修正，以免完全取消跳躍。
        if not flying and root.AssemblyLinearVelocity.Y <= 0.5 then
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {character}

            local result = Workspace:Raycast(
                root.Position,
                Vector3.new(0, -8, 0),
                params
            )

            if result then
                local rigOffset = humanoid.HipHeight + root.Size.Y / 2
                if humanoid.RigType == Enum.HumanoidRigType.R6 then
                    rigOffset += 1
                end

                local targetY = result.Position.Y + rigOffset
                local distance = root.Position.Y - targetY

                if distance >= -0.5 and distance <= 5 then
                    local pos = root.Position
                    root.CFrame = CFrame.new(pos.X, targetY, pos.Z) * 
                        CFrame.fromMatrix(Vector3.zero, root.CFrame.XVector, root.CFrame.YVector, root.CFrame.ZVector)
                    root.AssemblyLinearVelocity = Vector3.new(
                        root.AssemblyLinearVelocity.X,
                        0,
                        root.AssemblyLinearVelocity.Z
                    )
                end
            end
        end
    end)
end

noclipToggle.Activated:Connect(function()
    setNoclip(not noclipEnabled)
end)

